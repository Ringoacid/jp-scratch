<UserControl x:Class="JpScratch.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===== 検索行 ===== -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="検索"
                       Style="{StaticResource FieldLabel}" />

            <TextBox x:Name="SearchBox"
                     Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource AppTextBox}"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown" />

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="PrevButton" Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70E;"
                        ToolTip="前を検索 (Shift+F3)" Click="PrevButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70D;"
                        ToolTip="次を検索 (F3)" Click="NextButton_Click" />

                <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource ChromeToggle}"
                              Content="Aa" FontSize="11"
                              ToolTip="大文字と小文字を区別する"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource ChromeToggle}"
                              Content="語" FontSize="11"
                              ToolTip="単語単位で検索する（英数字向け）"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                <ToggleButton x:Name="RegexToggle" Style="{StaticResource ChromeToggle}"
                              Content=".*" FontSize="11"
                              ToolTip="正規表現（.NET 構文）"
                              Checked="Option_Changed" Unchecked="Option_Changed" />

                <TextBlock x:Name="MatchCountText"
                           MinWidth="70"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SubtleTextBrush}" />

                <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                        ToolTip="閉じる (Esc)" Click="CloseButton_Click" />
            </StackPanel>

            <!-- ===== 置換行 ===== -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="置換"
                       Margin="0,6,8,0"
                       Style="{StaticResource FieldLabel}" />

            <TextBox x:Name="ReplaceBox"
                     Grid.Row="1" Grid.Column="1"
                     Margin="0,6,0,0"
                     Style="{StaticResource AppTextBox}"
                     KeyDown="ReplaceBox_KeyDown" />

            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="6,6,0,0">
                <Button x:Name="ReplaceButton" Style="{StaticResource AppButton}"
                        Content="置換" MinWidth="52" Click="ReplaceButton_Click" />
                <Button x:Name="ReplaceAllButton" Style="{StaticResource AppButton}"
                        Content="すべて置換" MinWidth="80" Margin="4,0,0,0"
                        Click="ReplaceAllButton_Click" />
                <CheckBox x:Name="InSelectionCheck" Style="{StaticResource AppCheckBox}"
                          Content="選択範囲内" Margin="8,0,0,0"
                          ToolTip="選択している範囲だけを置換の対象にする" />
                <Button x:Name="CrossTabButton" Style="{StaticResource AppButton}"
                        Content="全タブ検索" MinWidth="86" Margin="8,0,0,0"
                        ToolTip="開いているタブとゴミ箱を横断して検索する (Ctrl+Shift+F)"
                        Click="CrossTabButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
