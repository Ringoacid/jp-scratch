<UserControl x:Class="JpScratch.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 「検索」「置換」の見出し。FieldLabel（設定画面用）は太字の 14px で、
             この密度のパネルでは入力欄より目立ってしまうため一段落とす。 -->
        <Style x:Key="FindPanelLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FindPanelButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- 主操作（入力欄に直接効くもの）。左揃えにして入力欄のすぐ右に置く。 -->
                <ColumnDefinition Width="Auto" />
                <!-- 補助（全タブ検索・置換の範囲指定）。右揃えにして右端を縦に揃える。 -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===== 検索行 ===== -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="検索"
                       Style="{StaticResource FindPanelLabel}" />

            <!-- 検索条件（Aa / 語 / .*）は検索欄の枠の内側に入れる。枠の外に矢印と並べると、
                 どちらが移動でどちらが条件なのか、どの入力欄に掛かるのかが分からない。 -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SearchFieldShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource SearchFieldTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,3,0">
                        <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource SearchOptionToggle}"
                                      Content="Aa"
                                      ToolTip="大文字と小文字を区別する"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                        <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource SearchOptionToggle}"
                                      Content="語"
                                      ToolTip="単語単位で検索する（英数字向け）"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                        <ToggleButton x:Name="RegexToggle" Style="{StaticResource SearchOptionToggle}"
                                      Content=".*"
                                      ToolTip="正規表現（.NET 構文）"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <!-- ヒット件数は検索欄のすぐ右。桁数で位置が動かないよう右揃えの最小幅を持たせる
                     （「不正な式」などの短い通知もここに出る）。 -->
                <TextBlock x:Name="MatchCountText"
                           MinWidth="52"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SubtleTextBrush}" />

                <Button x:Name="PrevButton" Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70E;"
                        ToolTip="前を検索 (Shift+F3)" Click="PrevButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70D;"
                        ToolTip="次を検索 (F3)" Click="NextButton_Click" />
            </StackPanel>

            <!-- 閉じるボタンだけは操作列の外に出し、パネルの右上隅へ固定する。 -->
            <Button x:Name="CloseButton"
                    Grid.Row="0" Grid.Column="4"
                    Style="{StaticResource ChromeButton}"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                    ToolTip="閉じる (Esc)" Click="CloseButton_Click" />

            <!-- ===== 置換行 ===== -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="置換"
                       Margin="0,6,8,0"
                       Style="{StaticResource FindPanelLabel}" />

            <Border Grid.Row="1" Grid.Column="1"
                    Margin="0,6,0,0"
                    Style="{StaticResource SearchFieldShell}">
                <TextBox x:Name="ReplaceBox"
                         Style="{StaticResource SearchFieldTextBox}"
                         ToolTip="正規表現が有効なときは $1 などの参照と \r、\n、\t を使用できます"
                         KeyDown="ReplaceBox_KeyDown" />
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="8,6,0,0">
                <Button x:Name="ReplaceButton" Style="{StaticResource FindPanelButton}"
                        Content="置換" MinWidth="56" Click="ReplaceButton_Click" />
                <Button x:Name="ReplaceAllButton" Style="{StaticResource FindPanelButton}"
                        Content="すべて置換" MinWidth="80" Margin="4,0,0,0"
                        Click="ReplaceAllButton_Click" />
            </StackPanel>

            <CheckBox x:Name="InSelectionCheck"
                      Grid.Row="1" Grid.Column="3"
                      Style="{StaticResource CompactCheckBox}"
                      HorizontalAlignment="Right"
                      Margin="12,6,0,0"
                      Content="選択範囲内"
                      ToolTip="選択している範囲だけを置換の対象にする" />

            <!--
                置換行より後に書く。Tab の順番は Grid の行・列ではなく XAML の記述順で決まるため、
                検索行の位置（Grid.Row="0"）に置きたいからといって上に書くと、
                Ctrl+F 直後の Tab が置換欄ではなくこのボタンへ飛ぶ。
            -->
            <Button x:Name="CrossTabButton"
                    Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource FindPanelButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Content="全タブ検索" MinWidth="86"
                    ToolTip="開いているタブとゴミ箱を横断して検索する (Ctrl+Shift+F)"
                    Click="CrossTabButton_Click" />
        </Grid>
    </Border>
</UserControl>
