# Visual Studio user and workspace files
.vs/
*.user

# Build output
bin/
obj/

# コードの行数を数える拡張機能の出力
.VSCodeCounter

# codex
.codex/

# github-copilot
.github/

# Python バイトコードキャッシュ
__pycache__/

# ランタイム同梱 MSI（55MB）と wixpdb はリポジトリに入れず、Releases の添付だけで配る
publish/msi/*-selfcontained.msi
publish/msi/*.wixpdb

# Claude Code のローカル専用設定（共有しない）
.claude/settings.local.json
.codex-loop/

# graphify: 再生成できる生成物・キャッシュ・自動バックアップは追跡しない
# （graph.json と GRAPH_REPORT.md だけあれば query / explain は動く）
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/graph.html
.claude/settings.json.graphify-bak

graphify-out/.graphify_python
graphify-out/.graphify_root
