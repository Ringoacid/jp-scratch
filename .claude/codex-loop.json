{
  "$schemaVersion": 1,
  "models": {
    "orchestrator": "opus",
    "advisor": "fable",
    "implementation": "gpt-5.6-luna",
    "review": "gpt-5.6-sol"
  },
  "codex": {
    "mcpServerName": "codex",
    "implementation": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "networkAccess": true
    },
    "review": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "networkAccess": true
    },
    "fallback": {
      "codexExec": "ask-user"
    }
  },
  "workflow": {
    "oneThemePerTask": true,
    "explicitPlanApproval": true,
    "explicitFixPlanApproval": true,
    "materialDeviationRequiresReapproval": true,
    "residualFindingsCompletionRequiresApproval": true,
    "cleanReviewCompletion": "orchestrator-advisor-auto-complete",
    "reuseImplementationThread": "prefer",
    "freshReviewThread": true,
    "transientRetryCount": 2,
    "questionStyle": "adaptive"
  },
  "taskState": {
    "statuses": ["active", "paused", "cancelled", "completed"],
    "atomicWrites": true,
    "backupGenerations": 1,
    "hashApprovedPlans": true,
    "retainArtifacts": true
  },
  "git": {
    "reviewScope": ["staged", "unstaged", "untracked"],
    "excludeIgnored": true,
    "excludeObviousGeneratedFiles": true,
    "staging": "allowed",
    "commit": "explicit-user-request-only",
    "destructiveOperations": "ask-user-first",
    "destructiveCommands": [
      "git reset",
      "git restore",
      "git checkout --",
      "git clean",
      "git stash"
    ]
  },
  "review": {
    "format": "markdown",
    "severityLabels": ["Critical", "High", "Medium", "Low"],
    "severityGuidanceIsStrict": false,
    "focus": [
      "correctness",
      "regressions",
      "security",
      "data-integrity",
      "error-handling",
      "concurrency",
      "material-performance-problems",
      "missing-or-insufficient-tests"
    ],
    "deemphasize": [
      "naming-only",
      "formatting-only",
      "style-only",
      "subjective-design-preferences"
    ],
    "runBuildAndTests": true
  },
  "plans": {
    "detailLevel": "medium",
    "includeCodeExamplesByDefault": false,
    "includeConcreteFileAndClassListsByDefault": false,
    "includeNonGoalsOnlyWhenImportant": true,
    "immutableAfterApproval": true
  },
  "ui": {
    "screenshots": "recommended-not-required"
  },
  "network": {
    "readOperations": "allowed",
    "safeWriteOperations": "allowed-when-no-cost-no-public-change-no-destructive-effect-no-third-party-impact",
    "costlyOrProductionOrDestructiveWrites": "ask-user-first"
  },
  "secrets": {
    "readSecretValuesIntoAgentContext": false,
    "programsMayConsumeEnvironmentVariablesWithoutExposingValues": true,
    "preferMaskedOrQuietLogs": true,
    "askBeforeCommandsLikelyToExposeSecrets": true
  },
  "artifacts": {
    "root": ".codex-loop/tasks",
    "taskFolder": "<日本語タスク名>-YYYYMMDD-HHMMSS",
    "planFile": "YYYYMMDD-HHMMSS-実装プラン.md / YYYYMMDD-HHMMSS-修正プラン.md",
    "reviewFile": "YYYYMMDD-HHMMSS-レビュー.md",
    "reportFile": "YYYYMMDD-HHMMSS-最終報告.md"
  }
}
