<Window x:Class="JpScratch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:infra="clr-namespace:JpScratch.Infrastructure"
        xmlns:controls="clr-namespace:JpScratch.Controls"
        Title="JP Scratch"
        Width="480" Height="600"
        MinWidth="320" MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <!-- 自前のタイトルバーを使う。CaptionHeight の範囲がドラッグ領域になる。 -->
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <infra:InverseBooleanToVisibilityConverter x:Key="BoolToCollapsed" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========== タイトルバー ========== -->
            <Grid Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="JP Scratch"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource ChromeToggle}"
                                  FontFamily="Segoe MDL2 Assets"
                                  Content="&#xE718;"
                                  ToolTip="常に手前に表示する（設定と同期）"
                                  Checked="PinButton_Changed"
                                  Unchecked="PinButton_Changed" />
                    <Button x:Name="TrashButton"
                            Style="{StaticResource ChromeButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE74D;"
                            ToolTip="ゴミ箱（閉じたタブの一覧）"
                            Click="TrashButton_Click" />
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource ChromeButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE713;"
                            ToolTip="設定"
                            Click="SettingsButton_Click" />
                    <Button x:Name="HideButton"
                            Style="{StaticResource ChromeButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE8BB;"
                            ToolTip="隠す（Esc）。終了はトレイアイコンから"
                            Click="HideButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ========== タブストリップ ========== -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ChromeBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button x:Name="NewTabButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ChromeButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE710;"
                            ToolTip="新しいタブ (Ctrl+T)"
                            Click="NewTabButton_Click" />

                    <ScrollViewer x:Name="TabScroller"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TabScroller_PreviewMouseWheel">
                        <ItemsControl x:Name="TabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabRoot"
                                            Margin="2,3,0,0"
                                            CornerRadius="4,4,0,0"
                                            Background="{DynamicResource TabInactiveBackgroundBrush}"
                                            MouseLeftButtonDown="TabItem_MouseLeftButtonDown"
                                            MouseMove="TabItem_MouseMove"
                                            MouseLeftButtonUp="TabItem_MouseLeftButtonUp"
                                            MouseDown="TabItem_MouseDown">
                                        <Grid>
                                            <!-- アクティブなタブの上端に引く帯。重ねて描くので、
                                                 表示・非表示でタブの高さが動かない。 -->
                                            <Border x:Name="ActiveMarker"
                                                    Height="2"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="2,2,0,0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" />

                                            <Grid Margin="8,5,4,4">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}">
                                                    <TextBlock x:Name="TabTitle"
                                                               Text="{Binding Title}"
                                                               MaxWidth="150"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                                    <Button Content="&#xE711;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="9"
                                                            Width="18" Height="18"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource ChromeButton}"
                                                            ToolTip="タブを閉じる (Ctrl+W)"
                                                            Click="CloseTabButton_Click" />
                                                </StackPanel>

                                                <TextBox x:Name="RenameBox"
                                                         MinWidth="80"
                                                         Style="{StaticResource AppTextBox}"
                                                         Text="{Binding Title, Mode=OneWay}"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                                         KeyDown="RenameBox_KeyDown"
                                                         LostFocus="RenameBox_LostFocus" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!-- ホバーを先、アクティブを後に書く。逆にすると、
                                             アクティブなタブにカーソルを乗せた瞬間に選択の見た目が消える。 -->
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background"
                                                    Value="{DynamicResource TabHoverBackgroundBrush}" />
                                            <Setter TargetName="TabTitle" Property="Foreground"
                                                    Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background"
                                                    Value="{DynamicResource TabActiveBackgroundBrush}" />
                                            <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TabTitle" Property="Foreground"
                                                    Value="{DynamicResource TextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ========== エディタ ========== -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:FindReplacePanel x:Name="FindPanel"
                                           Grid.Row="0"
                                           Visibility="Collapsed" />

                <avalon:TextEditor x:Name="Editor"
                                   Grid.Row="1"
                                   Padding="6,4"
                                   BorderThickness="0"
                                   ShowLineNumbers="True"
                                   WordWrap="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Background="{DynamicResource EditorBackgroundBrush}"
                                   Foreground="{DynamicResource EditorForegroundBrush}"
                                   PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                                   PreviewMouseWheel="Editor_PreviewMouseWheel"
                                   ContextMenuOpening="Editor_ContextMenuOpening">
                    <avalon:TextEditor.ContextMenu>
                        <!-- proofreading-ux-fixes-plan.md §10。「元に戻す」「やり直し」は追加しない。
                             切り取り・コピー・貼り付け・削除・すべて選択は標準コマンドのため、
                             選択やクリップボード状態に応じて自動で有効・無効が切り替わる。 -->
                        <ContextMenu>
                            <MenuItem Header="切り取り" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" />
                            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                            <MenuItem Header="貼り付け" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
                            <MenuItem Header="削除" Command="ApplicationCommands.Delete" InputGestureText="Del" />
                            <MenuItem Header="すべて選択" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                            <Separator />
                            <MenuItem Tag="upper" Header="大文字に変換" Click="Editor_UppercaseMenuItem_Click" />
                            <MenuItem Tag="lower" Header="小文字に変換" Click="Editor_LowercaseMenuItem_Click" />
                            <Separator />
                            <MenuItem Tag="missed" Header="校正漏れを報告…"
                                      InputGestureText="Ctrl+Shift+M"
                                      Click="MissedCorrectionMenuItem_Click" />
                        </ContextMenu>
                    </avalon:TextEditor.ContextMenu>
                </avalon:TextEditor>

                <Border x:Name="ProofreadingPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="{DynamicResource ChromeBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProposalPositionText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}" />

                        <TextBlock x:Name="ProposalChangeText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="40"
                                   Foreground="{DynamicResource TextBrush}" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,7,0,0">
                            <Button x:Name="AcceptAllProposalsButton"
                                    Style="{StaticResource AppButton}"
                                    Content="すべて許可"
                                    ToolTip="すべて許可 (Ctrl+Shift+.)"
                                    Margin="0,0,6,0"
                                    Click="AcceptAllProposalsButton_Click" />
                            <Button x:Name="AcceptProposalButton"
                                    Style="{StaticResource AppButton}"
                                    Content="許可"
                                    ToolTip="許可 (Ctrl+.)"
                                    Margin="0,0,6,0"
                                    Click="AcceptProposalButton_Click" />
                            <Button x:Name="RejectProposalButton"
                                    Style="{StaticResource AppButton}"
                                    Content="拒否"
                                    ToolTip="拒否 (Ctrl+,)"
                                    Margin="0,0,6,0"
                                    Click="RejectProposalButton_Click" />
                            <Button x:Name="ReasonProposalButton"
                                    Style="{StaticResource AppButton}"
                                    Content="理由をつけて… ▼"
                                    Click="ReasonProposalButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="理由をつけて退ける"
                                                  Click="RejectWithReasonMenuItem_Click" />
                                        <MenuItem Header="理由をつけて別案を出す（API料金が発生）"
                                                  Click="AlternativeWithReasonMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Margin="10,0,0,0">
                            <Button Style="{StaticResource ChromeButton}"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE76B;"
                                    ToolTip="前の提案"
                                    Click="PreviousProposalButton_Click" />
                            <Button Style="{StaticResource ChromeButton}"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE76C;"
                                    ToolTip="次の提案"
                                    Click="NextProposalButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== ステータスバー ========== -->
            <Border Grid.Row="3"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="StatusRight"
                                   DockPanel.Dock="Right"
                                   MaxWidth="210"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock x:Name="StatusLeft"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,1,0,0">
                        <!-- 上限0（無制限）のときは Visibility="Collapsed" で潰れ、レイアウトは崩れない -->
                        <ProgressBar x:Name="UsageLimitProgressBar"
                                     DockPanel.Dock="Right"
                                     Style="{StaticResource UsageProgressBar}"
                                     Width="54"
                                     Height="5"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                        <!--
                            上限到達の警告は、可変幅の StatusUsage とは別の固定要素として
                            DockPanel.Dock="Right" 側に置く。狭いウィンドウで StatusUsage が
                            CharacterEllipsis で省略されても、この要素自体はトリミングされず、
                            「自動停止」の理由が読めなくなることがない（実機で幅480px程度のとき発生）。
                            未到達・無制限のときは Collapsed で潰れ、レイアウトは崩れない。
                        -->
                        <TextBlock x:Name="StatusUsageLimitWarning"
                                   DockPanel.Dock="Right"
                                   FontSize="10"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="⚠自動停止(上限)"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="StatusUsage_MouseLeftButtonUp"
                                   Foreground="{DynamicResource UsageProgressReachedBrush}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="StatusUsage"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="StatusUsage_MouseLeftButtonUp"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
