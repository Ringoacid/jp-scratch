<Window x:Class="JpScratch.Views.MissedCorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="校正漏れを報告"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <StackPanel>
                <TextBlock Text="校正漏れを報告"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <TextBlock Text="モデルが見逃した誤字・脱字・余分な文字を記録します。記録した内容は将来の校正の参考（few-shot 候補）として使われます。この操作自体では API を呼びません。"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>

            <!-- プレビュー -->
            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="{DynamicResource SettingsCardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="プレビュー（前後の文脈と修正箇所）"
                               Style="{StaticResource FieldLabel}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="PreviewText"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 修正前 -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="修正前" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="OriginalBox"
                         Style="{StaticResource AppTextBox}"
                         MinHeight="40"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         IsReadOnly="True"
                         ToolTip="選択範囲（読み取り専用）。選択がない場合は挿入位置を示します。" />
            </StackPanel>

            <!-- 修正後 -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="修正後" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="CorrectedBox"
                         Style="{StaticResource AppTextBox}"
                         MinHeight="40"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         TextChanged="CorrectedBox_TextChanged"
                         ToolTip="置換後の文字列です。空欄にすると「削除」になります。選択がなく空欄のままでは実行できません。" />
            </StackPanel>

            <!-- 補足理由 -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="補足理由（任意）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="ReasonBox"
                         Style="{StaticResource AppTextBox}"
                         MinHeight="40"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         ToolTip="なぜこの訂正が必要か、将来の学習の参考になるメモを残せます。" />
            </StackPanel>

            <!-- ボタン -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="キャンセル"
                        Style="{StaticResource AppButton}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button x:Name="ExecuteButton"
                        Style="{StaticResource AppButton}"
                        MinWidth="180"
                        IsDefault="True"
                        Click="ExecuteButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
