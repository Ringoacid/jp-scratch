<Window x:Class="JpScratch.Views.FxRateCompletionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="未確認料金の補完"
        Width="720" Height="500"
        MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="未確認料金の補完"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        ToolTip="閉じる"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="呼び出し日のレートを API で取得するか、レート欄へ直接入力してください。週末は直前の営業日の基準日が記録されます。"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="SummaryText"
                           Grid.Row="1"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Margin="0,0,0,10" />

                <ListView x:Name="RatesList"
                          Grid.Row="2"
                          Background="{DynamicResource ControlBackgroundBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ItemContainerStyle="{StaticResource AppListViewItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="呼び出し日" Width="120" DisplayMemberBinding="{Binding CalledDateText}" />
                            <GridViewColumn Header="補完対象" Width="90" DisplayMemberBinding="{Binding CompletableCountText}" />
                            <GridViewColumn Header="直せない行" Width="110" DisplayMemberBinding="{Binding UncompletableCountText}" />
                            <GridViewColumn Header="USD/JPYレート" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource AppTextBox}"
                                                 Width="150"
                                                 HorizontalContentAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="MessageText"
                           Grid.Row="3"
                           Margin="0,10,0,8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleTextBrush}" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="FetchButton"
                            Style="{StaticResource AppButton}"
                            Content="APIで取得"
                            Margin="0,0,8,0"
                            Click="FetchButton_Click" />
                    <Button x:Name="CancelButton"
                            Style="{StaticResource AppButton}"
                            Content="キャンセル"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="ApplyButton"
                            Style="{StaticResource AppButton}"
                            Content="適用"
                            Click="ApplyButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
