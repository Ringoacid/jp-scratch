<Window x:Class="JpScratch.Views.CrossTabSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全タブ検索"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 検索条件 -->
        <DockPanel Grid.Row="0">
            <Button x:Name="SearchButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource AppButton}"
                    Content="検索"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click" />
            <TextBox x:Name="TermBox"
                     Style="{StaticResource AppTextBox}"
                     KeyDown="TermBox_KeyDown" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="MatchCaseCheck" Style="{StaticResource AppCheckBox}"
                      Content="大文字と小文字を区別" Margin="0,0,16,0" />
            <CheckBox x:Name="RegexCheck" Style="{StaticResource AppCheckBox}"
                      Content="正規表現" Margin="0,0,16,0" />
            <CheckBox x:Name="IncludeTrashCheck" Style="{StaticResource AppCheckBox}"
                      Content="ゴミ箱も含める" IsChecked="True" />
        </StackPanel>

        <!-- 結果 -->
        <ListView x:Name="ResultsList"
                  Grid.Row="2"
                  Margin="0,10,0,0"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  ItemContainerStyle="{StaticResource AppListViewItem}"
                  MouseDoubleClick="ResultsList_MouseDoubleClick"
                  KeyDown="ResultsList_KeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="タブ" Width="160" DisplayMemberBinding="{Binding TabTitle}" />
                    <GridViewColumn Header="行" Width="60" DisplayMemberBinding="{Binding LineNumber}" />
                    <GridViewColumn Header="内容" Width="440" DisplayMemberBinding="{Binding Preview}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleTextBrush}" />
            <Button x:Name="JumpButton"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AppButton}"
                    Content="この箇所へ移動"
                    MinWidth="120"
                    Click="JumpButton_Click" />
        </DockPanel>
    </Grid>
</Window>
