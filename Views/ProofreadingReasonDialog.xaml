<Window x:Class="JpScratch.Views.ProofreadingReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="理由を入力"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DescriptionText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <ComboBox x:Name="ReasonBox"
                      Grid.Row="1"
                      Style="{StaticResource AppComboBox}"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      MinWidth="380"
                      MaxDropDownHeight="180" />

            <TextBlock x:Name="CostNoticeText"
                       Grid.Row="2"
                       Margin="0,9,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleTextBrush}" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="キャンセル"
                        Style="{StaticResource AppButton}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="決定"
                        Style="{StaticResource AppButton}"
                        IsDefault="True"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
