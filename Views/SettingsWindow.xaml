<Window x:Class="JpScratch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="JP Scratch の設定"
        Width="520" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 「明細の保持期間」の説明。入力欄の右側に置くには長すぎて切れるため、
             ラベル・入力欄・単位の3か所から同じ ToolTip として参照する。 -->
        <system:String x:Key="ApiLogRetentionHelp">これより古い月の課金明細を日次サマリへ圧縮し、明細の行を削除します（起動時・この設定を変更したとき・日付が変わったときに実行）。期間合計・件数・トークン数・料金は変わりません。失われるのは1件ごとの時刻・所要時間・エラー文だけです。0で無期限。</system:String>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="JP Scratch の設定"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        ToolTip="閉じる"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="TitleBarCloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" Style="{StaticResource AppTabControl}">

                    <!-- ===== 全般（表示・ホットキー・保存・その他） ===== -->
                    <TabItem Header="全般">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="表示" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ウィンドウの表示位置" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PositionCombo" Grid.Column="1" Style="{StaticResource AppComboBox}" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="テーマ" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource AppComboBox}" />
                            </Grid>

                            <CheckBox x:Name="TopmostCheck" Style="{StaticResource AppCheckBox}"
                                      Content="常に手前に表示する" />
                            <CheckBox x:Name="HideOnFocusLostCheck" Style="{StaticResource AppCheckBox}"
                                      Content="フォーカスが外れたら自動的に隠す" />
                            <CheckBox x:Name="CopyOnHideCheck" Style="{StaticResource AppCheckBox}"
                                      Content="隠すときに本文をクリップボードへコピーする"
                                      ToolTip="フォーカス喪失・ホットキー・Esc・閉じるボタン、どの隠し方でもコピーします" />

                            <!-- ===== ホットキー ===== -->
                            <TextBlock Text="グローバルホットキー" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="入力欄を選んでキーを押すと割り当てられます。Backspace で解除。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表示 / 非表示" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ToggleHotkeyBox" Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         IsReadOnly="True"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="全文をコピーして隠す" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CopyHideHotkeyBox" Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         IsReadOnly="True"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            </Grid>

                            <!-- ===== 保存 ===== -->
                            <TextBlock Text="保存" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自動保存の待ち時間" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AutoSaveBox" Grid.Column="1" Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="ミリ秒" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ゴミ箱の保持期間" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TrashDaysBox" Grid.Column="1" Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="日" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                            </Grid>

                            <!-- ===== その他 ===== -->
                            <TextBlock Text="その他" Style="{StaticResource SectionHeader}" />
                            <CheckBox x:Name="StartupCheck" Style="{StaticResource AppCheckBox}"
                                      Content="Windows のサインイン時に常駐を開始する" />

                            <TextBlock x:Name="DataFolderText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== エディタ ===== -->
                    <TabItem Header="エディタ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="エディタ" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="フォント" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource AppComboBox}"
                                          IsEditable="False" MaxDropDownHeight="320" />
                                <TextBox x:Name="FontSizeBox" Grid.Column="2" Width="56" Margin="8,0,0,0"
                                         Style="{StaticResource AppTextBox}" TextAlignment="Right"
                                         ToolTip="フォントサイズ（Ctrl + マウスホイールでも変えられます）" />
                            </Grid>

                            <CheckBox x:Name="WordWrapCheck" Style="{StaticResource AppCheckBox}" Content="折り返して表示する" />
                            <CheckBox x:Name="LineNumbersCheck" Style="{StaticResource AppCheckBox}" Content="行番号を表示する" />
                            <CheckBox x:Name="CurrentLineCheck" Style="{StaticResource AppCheckBox}" Content="現在の行をハイライトする" />
                            <CheckBox x:Name="WhitespaceCheck" Style="{StaticResource AppCheckBox}"
                                      Content="空白（半角・全角スペース、タブ）を可視化する" />
                            <CheckBox x:Name="EndOfLineCheck" Style="{StaticResource AppCheckBox}" Content="改行記号を表示する" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== 校正 ===== -->
                    <TabItem Header="校正">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="校正" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="使用モデル" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ProofreadingModelCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBox}" />
                            </Grid>

                            <CheckBox x:Name="AutoProofreadingCheck"
                                      Style="{StaticResource AppCheckBox}"
                                      Content="入力停止後に自動で校正する" />

                            <CheckBox x:Name="ConfirmPaidApiCallsCheck"
                                      Style="{StaticResource AppCheckBox}"
                                      Content="課金API実行前の確認を表示する"
                                      ToolTip="オフにすると、校正・別案生成の前に確認せず実行します。" />

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="入力停止後の待ち時間" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProofreadingDebounceBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="ミリ秒"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小送信間隔" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ProofreadingIntervalBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="秒"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="月間上限額"
                                           Style="{StaticResource FieldLabel}"
                                           ToolTip="当月の累計がこの額以上になると自動校正を停止します。0で無制限。" />
                                <TextBox x:Name="MonthlyLimitBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="USD（0で無制限）"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="上限接近の警告"
                                           Style="{StaticResource FieldLabel}"
                                           ToolTip="当月の累計がこの割合を超えたら、ステータスバーの進捗バーを警告色にします。" />
                                <TextBox x:Name="MonthlyLimitWarningBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="%"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="明細の保持期間"
                                           Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource ApiLogRetentionHelp}" />
                                <TextBox x:Name="ApiLogRetentionBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right"
                                         ToolTip="{StaticResource ApiLogRetentionHelp}" />
                                <!-- 補足は必ずウィンドウ幅に収まる長さにする。長い説明をここへ置くと
                                     TextTrimming も Wrap も無いこの列で右端が黙って切れる（実機で踏んだ）。
                                     詳しい説明は ToolTip 側に置く。 -->
                                <TextBlock Grid.Column="2"
                                           Text="か月（0で無期限）"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0"
                                           ToolTip="{StaticResource ApiLogRetentionHelp}" />
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== 学習（文体の適応） ===== -->
                    <TabItem Header="学習">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="学習（文体の適応）" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                            <TextBlock Text="カスタム指示" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="校正のたびに必ず伝える、あなた自身の指示です。自動生成スタイルガイドより優先されます。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="CustomInstructionBox"
                                     Style="{StaticResource AppTextBox}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <CheckBox x:Name="StyleGuideAutoGenerateCheck"
                                      Style="{StaticResource AppCheckBox}"
                                      Content="リアクションが一定件数たまったらスタイルガイドの生成を提案する"
                                      ToolTip="OFFでも「学習」セクションの手編集は引き続き可能です。生成は課金APIを呼ぶため、この設定に関わらず毎回確認します。" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="生成を提案する件数"
                                           Style="{StaticResource FieldLabel}"
                                           ToolTip="前回の確認時点から、これだけ新しいリアクションが積まれたら生成を提案します。" />
                                <TextBox x:Name="StyleGuideThresholdBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="件ごと"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="スタイルガイドの世代" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="StyleGuideHistoryCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="StyleGuideHistoryCombo_SelectionChanged" />
                            </Grid>

                            <TextBlock x:Name="StyleGuideStatusText"
                                       Margin="150,2,0,4"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}" />

                            <TextBox x:Name="StyleGuideContentBox"
                                     Style="{StaticResource AppTextBox}"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,4"
                                     ToolTip="生成された（または編集した）ルール文です。自由に書き換えられます。" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button x:Name="StyleGuideSaveButton" Style="{StaticResource AppButton}"
                                        Content="保存" Click="StyleGuideSaveButton_Click" />
                                <Button x:Name="StyleGuideActivateButton" Style="{StaticResource AppButton}"
                                        Content="この世代を使う" Margin="8,0,0,0" Click="StyleGuideActivateButton_Click" />
                                <Button x:Name="StyleGuideDeactivateButton" Style="{StaticResource AppButton}"
                                        Content="無効化" Margin="8,0,0,0" Click="StyleGuideDeactivateButton_Click" />
                                <Button x:Name="StyleGuideDeleteButton" Style="{StaticResource AppButton}"
                                        Content="この世代を削除" Margin="8,0,0,0" Click="StyleGuideDeleteButton_Click" />
                            </StackPanel>

                            <!-- ===== 学習効果 ===== -->
                            <TextBlock Text="学習効果" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="リアクションを蓄積順にまとめて、拒否率の推移を表示します（暦月ではなく件数で区切ります。学習が効いていれば右に行くほど下がります）。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />
                            <StackPanel x:Name="RejectionTrendPanel" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== API・料金（モデル単価・APIキー） ===== -->
                    <TabItem Header="API・料金">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="モデル単価" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <TextBlock Text="各サービス公式の価格が変わったときに更新します。1M tokensあたりのUSDです。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="モデル" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PricingModelCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="PricingModelCombo_SelectionChanged" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="入力単価" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PricingInputBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="USD / 1M tokens"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="出力単価" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PricingOutputBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="USD / 1M tokens（thinking を含む）"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="更新日" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PricingUpdatedAtBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="yyyy-MM-dd"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock x:Name="PricingErrorText"
                                       Margin="150,2,0,8"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="Collapsed" />

                            <!-- ===== APIキー ===== -->
                            <TextBlock Text="APIキー" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gemini APIキーの取得元" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CredentialSourceCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="CredentialSourceCombo_SelectionChanged" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新しい API キー" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ApiKeyBox"
                                             Grid.Column="1"
                                             Style="{StaticResource AppPasswordBox}"
                                             PasswordChar="●"
                                             PasswordChanged="ApiKeyBox_PasswordChanged"
                                             ToolTip="既存のキーは表示しません。未入力のままなら変更しません。" />
                                <Button x:Name="DeleteStoredKeyButton"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppButton}"
                                        Content="保存済みキーを削除"
                                        Click="DeleteStoredKeyButton_Click" />
                            </Grid>

                            <TextBlock x:Name="CredentialStatusText"
                                       Margin="150,2,0,2"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}" />

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OpenAI APIキーの取得元" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OpenAiCredentialSourceCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="OpenAiCredentialSourceCombo_SelectionChanged" />
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新しいOpenAIキー" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="OpenAiApiKeyBox"
                                             Grid.Column="1"
                                             Style="{StaticResource AppPasswordBox}"
                                             PasswordChar="●"
                                             PasswordChanged="OpenAiApiKeyBox_PasswordChanged"
                                             ToolTip="既存のキーは表示しません。未入力のままなら変更しません。" />
                                <Button x:Name="DeleteOpenAiStoredKeyButton"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppButton}"
                                        Content="保存済みキーを削除"
                                        Click="DeleteOpenAiStoredKeyButton_Click" />
                            </Grid>

                            <TextBlock x:Name="OpenAiCredentialStatusText"
                                       Margin="150,2,0,2"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button x:Name="OpenFolderButton"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AppButton}"
                    Content="データフォルダを開く"
                    MinWidth="140"
                    Click="OpenFolderButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource AppButton}" Content="キャンセル"
                        MinWidth="90" IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="OkButton" Style="{StaticResource AppButton}" Content="OK"
                        MinWidth="90" Margin="8,0,0,0" IsDefault="True" Click="OkButton_Click" />
            </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
