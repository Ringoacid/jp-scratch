<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:JpScratch.Controls"
        x:Class="JpScratch.Views.SettingsWindow"
        Title="JP Scratch の設定"
        Width="960"
        Height="780"
        MinWidth="840"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="SettingsWindow_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsNavigationItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="14,10">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" FontWeight="Normal" Width="28" VerticalAlignment="Center"
                                               Focusable="False" IsHitTestVisible="False" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigation" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ChromeBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel Margin="12,24,12,12">
                                    <StackPanel DockPanel.Dock="Top" Margin="14,0,0,24">
                                        <TextBlock Text="設定" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="JP Scratch" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="1" Margin="24,24,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding SelectedItem.ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                               Style="{DynamicResource SettingsDescription}" Margin="0,6,0,0" />
                                </StackPanel>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 「明細の保持期間」の説明。入力欄の右側に置くには長すぎて切れるため、
             ラベル・入力欄・単位の3か所から同じ ToolTip として参照する。 -->
        <system:String x:Key="ApiLogRetentionHelp">これより古い月の課金明細を日次サマリへ圧縮し、明細の行を削除します（起動時・この設定を変更したとき・日付が変わったときに実行）。期間合計・件数・トークン数・料金は変わりません。失われるのは1件ごとの時刻・所要時間・エラー文だけです。0で無期限。</system:String>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Padding" Value="0,13" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style x:Key="SettingsLastRow" TargetType="Border" BasedOn="{StaticResource SettingsRow}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style x:Key="SettingsSaveButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="{DynamicResource SettingsActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="16,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HotkeyInput" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="MinHeight" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="JP Scratch の設定"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets"
                        Content=""
                        ToolTip="閉じる"
                        AutomationProperties.Name="設定を保存せずに閉じる"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="TitleBarCloseButton_Click" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TabControl x:Name="SettingsTabs"
                            Grid.Row="0"
                            Style="{StaticResource SettingsNavigation}">
                    <!-- ===== 全般（表示・ホットキー・保存・その他） ===== -->
                    <TabItem Header="全般" Tag="&#xE713;" ToolTip="表示やショートカットを、自分の使い方に合わせます。" x:Name="GeneralTab">
                        <ScrollViewer TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="表示" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ウィンドウの表示位置" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="PositionCombo" AutomationProperties.Name="ウィンドウの表示位置"
                                                          Grid.Column="1"
                                                          Width="320"
                                                          HorizontalAlignment="Right"
                                                          Style="{StaticResource AppComboBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="テーマ" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="ThemeCombo" AutomationProperties.Name="テーマ"
                                                          Grid.Column="1"
                                                          Width="320"
                                                          HorizontalAlignment="Right"
                                                          Style="{StaticResource AppComboBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="常に手前に表示する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="TopmostCheck" AutomationProperties.Name="常に手前に表示する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="フォーカスが外れたら自動的に隠す" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="HideOnFocusLostCheck" AutomationProperties.Name="フォーカスが外れたら自動的に隠す"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="隠すときに本文をコピーする"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="フォーカス喪失・ホットキー・Esc・閉じるボタンなど、どの方法で非表示にしてもコピーします。" />
                                                <CheckBox x:Name="CopyOnHideCheck" AutomationProperties.Name="隠すときに本文をコピーする"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}"
                                                          ToolTip="フォーカス喪失・ホットキー・Esc・閉じるボタンなど、どの方法で非表示にしてもコピーします。" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- ===== ホットキー ===== -->
                                <TextBlock Text="グローバルホットキー" Style="{StaticResource SectionHeader}" Margin="0,10,0,6" />
                                <TextBlock Text="欄を選んでキーを押すと変更できます。Backspace で解除。"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="表示 / 非表示" Style="{StaticResource FieldLabel}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBox x:Name="ToggleHotkeyBox"
                                                             Style="{StaticResource HotkeyInput}"
                                                             IsReadOnly="True"
                                                             AutomationProperties.Name="表示 / 非表示のホットキー"
                                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                             HorizontalAlignment="Stretch"
                                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                                    <TextBlock x:Name="ToggleHotkeyStatus"
                                                               Text="クリックして変更"
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource SettingsDescription}"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="全文をコピーして隠す" Style="{StaticResource FieldLabel}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBox x:Name="CopyHideHotkeyBox"
                                                             Style="{StaticResource HotkeyInput}"
                                                             IsReadOnly="True"
                                                             AutomationProperties.Name="全文をコピーして隠すのホットキー"
                                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                             HorizontalAlignment="Stretch"
                                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                                    <TextBlock x:Name="CopyHideHotkeyStatus"
                                                               Text="クリックして変更"
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource SettingsDescription}"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Expander Header="保存・起動とサポート" Style="{StaticResource SettingsExpander}">
                                    <StackPanel>
                                        <!-- ===== 保存 ===== -->
                                        <TextBlock Text="保存" Style="{StaticResource SectionHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="210" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="自動保存の待ち時間" Style="{StaticResource FieldLabel}" />
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="AutoSaveBox" AutomationProperties.Name="自動保存の待ち時間"
                                                                     Style="{StaticResource AppTextBox}"
                                                                     TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="ミリ秒"
                                                                       Style="{StaticResource FieldLabel}"
                                                                       Margin="0" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="210" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="ゴミ箱の保持期間" Style="{StaticResource FieldLabel}" />
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="TrashDaysBox" AutomationProperties.Name="ゴミ箱の保持期間"
                                                                     Style="{StaticResource AppTextBox}"
                                                                     TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="日"
                                                                       Style="{StaticResource FieldLabel}"
                                                                       Margin="0" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <!-- ===== その他 ===== -->
                                        <TextBlock Text="その他" Style="{StaticResource SectionHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <Border Style="{StaticResource SettingsLastRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Windows のサインイン時に常駐を開始する" Style="{StaticResource FieldLabel}" />
                                                    <CheckBox x:Name="StartupCheck" AutomationProperties.Name="Windows のサインイン時に常駐を開始する"
                                                              Grid.Column="1"
                                                              Style="{StaticResource AppToggleCheckBox}" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <TextBlock x:Name="DataFolderText"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                        <!-- ===== サポート ===== -->
                                        <Expander Header="サポート・バックアップ" Style="{StaticResource SettingsExpander}">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingsCard}">
                                                    <StackPanel Margin="10,8">
                                                        <TextBlock x:Name="VersionText"
                                                                   Style="{StaticResource FieldLabel}"
                                                                   Margin="0,0,0,4" />
                                                        <TextBlock Text="GitHub Releases で更新を確認します。"
                                                                   ToolTip="更新確認はGitHub Releasesを参照します。アプリが勝手に更新をインストールすることはありません。"
                                                                   Style="{StaticResource SettingsDescription}" />
                                                        <TextBlock Text="バックアップには保存済みの設定と本文が含まれます。編集中の設定は先に保存してください。"
                                                                   ToolTip="バックアップには、すでに保存されている設定とタブ本文が含まれます。この画面で編集中の設定は、いったん保存して閉じるで保存してから作成してください。"
                                                                   Style="{StaticResource SettingsDescription}"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock Text="復元するとアプリを再起動します。現在のデータは退避フォルダへ残すため、あとから戻せます。"
                                                                   Style="{StaticResource SettingsDescription}"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock x:Name="UpdateStatusText"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button x:Name="CheckForUpdatesButton"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="更新を確認"
                                                                    Margin="0,0,8,8"
                                                                    Click="CheckForUpdatesButton_Click" />
                                                            <Button x:Name="CreateBackupButton"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="バックアップを作成"
                                                                    Margin="0,0,8,8"
                                                                    Click="CreateBackupButton_Click" />
                                                            <Button x:Name="RestoreBackupButton"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="バックアップから復元"
                                                                    Margin="0,0,8,8"
                                                                    Click="RestoreBackupButton_Click" />
                                                            <Button x:Name="CopyDiagnosticsButton"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="診断情報をコピー"
                                                                    Margin="0,0,8,8"
                                                                    Click="CopyDiagnosticsButton_Click" />
                                                            <Button x:Name="ReportIssueButton"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="不具合を報告（Issue）"
                                                                    Margin="0,0,8,8"
                                                                    Click="ReportIssueButton_Click" />
                                                        </WrapPanel>
                                                        <TextBlock Text="診断情報には本文やAPIキーを含めません。Issueへ貼り付ける前に、内容を確認してください。"
                                                                   Style="{StaticResource SettingsDescription}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ===== エディタ ===== -->
                    <TabItem Header="エディタ" Tag="&#xE70F;" ToolTip="文字の見た目と、編集時の表示を調整します。">
                        <ScrollViewer TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="文字と表示" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="フォント" Style="{StaticResource FieldLabel}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ComboBox x:Name="FontCombo" AutomationProperties.Name="フォント"
                                                              Width="300"
                                                              Style="{StaticResource AppComboBox}"
                                                              IsEditable="False"
                                                              MaxDropDownHeight="320" />
                                                    <TextBox x:Name="FontSizeBox" AutomationProperties.Name="フォントサイズ"
                                                             Width="72"
                                                             Margin="10,0,0,0"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right"
                                                             ToolTip="フォントサイズ（Ctrl + マウスホイールでも変えられます）" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="折り返して表示する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="WordWrapCheck" AutomationProperties.Name="折り返して表示する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="行番号を表示する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="LineNumbersCheck" AutomationProperties.Name="行番号を表示する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="現在の行をハイライトする" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="CurrentLineCheck" AutomationProperties.Name="現在の行をハイライトする"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="スペース・タブを可視化する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="WhitespaceCheck" AutomationProperties.Name="スペース・タブを可視化する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="改行記号を表示する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="EndOfLineCheck" AutomationProperties.Name="改行記号を表示する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ===== 校正 ===== -->
                    <TabItem Header="校正" Tag="&#xE8F1;" ToolTip="使うモデルと、自動校正のタイミングを選びます。">
                        <ScrollViewer TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="使用するモデル" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="自動校正" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                                                <TextBlock Text="入力中の校正と、別案の生成に使います。" Style="{StaticResource SettingsDescription}" Margin="0,3,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="AutoModelFamilyCombo" Margin="0,0,8,0" Style="{StaticResource AppComboBox}"
                                                              AutomationProperties.Name="自動校正のサービス" SelectionChanged="ModelFamilyCombo_SelectionChanged" />
                                                    <ComboBox x:Name="AutoProofreadingModelCombo" Grid.Column="1" Style="{StaticResource AppComboBox}"
                                                              AutomationProperties.Name="自動校正のモデル" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                              SelectionChanged="ProofreadingModelCombo_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <StackPanel>
                                                <TextBlock Text="手動校正" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                                                <TextBlock Text="手動の校正と、スタイルガイドの生成に使います。" Style="{StaticResource SettingsDescription}" Margin="0,3,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ManualModelFamilyCombo" Margin="0,0,8,0" Style="{StaticResource AppComboBox}"
                                                              AutomationProperties.Name="手動校正のサービス" SelectionChanged="ModelFamilyCombo_SelectionChanged" />
                                                    <ComboBox x:Name="ManualProofreadingModelCombo" Grid.Column="1" Style="{StaticResource AppComboBox}"
                                                              AutomationProperties.Name="手動校正のモデル" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                              SelectionChanged="ProofreadingModelCombo_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HighCostModelWarningBorder"
                                                        Margin="0,6,0,2"
                                                        Padding="9,7"
                                                        BorderBrush="{DynamicResource UsageProgressWarningBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="高価格な校正モデルの注意">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource UsageProgressWarningBrush}"
                                                   Text="&#xE7BA;"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,8,0" />
                                        <TextBlock x:Name="HighCostModelWarningText"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsDescription}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="自動校正" Style="{StaticResource SectionHeader}" />
                                <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="入力停止後に自動で校正する" Style="{StaticResource FieldLabel}" />
                                                <CheckBox x:Name="AutoProofreadingCheck" AutomationProperties.Name="入力停止後に自動で校正する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="入力停止後の待ち時間" Style="{StaticResource FieldLabel}" />
                                                <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ProofreadingDebounceBox" AutomationProperties.Name="入力停止後の待ち時間"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="ミリ秒"
                                                               Style="{StaticResource FieldLabel}"
                                                               Margin="0" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel></Border>
                                <Expander Header="詳細設定：送信間隔・タイムアウト" Style="{StaticResource SettingsExpander}">
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="最小送信間隔" Style="{StaticResource FieldLabel}" />
                                                        <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="ProofreadingIntervalBox" AutomationProperties.Name="最小送信間隔"
                                                                     Style="{StaticResource AppTextBox}"
                                                                     TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="秒"
                                                                       Style="{StaticResource FieldLabel}"
                                                                       Margin="0" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="同時送信する段落数" Style="{StaticResource FieldLabel}" />
                                                            <TextBlock Text="増やすと高速になりますが、APIの制限に達しやすくなります。"
                                                                       ToolTip="大きくすると速くなりますが、APIのレート制限に当たりやすくなります。課金額は変わりません。"
                                                                       Style="{StaticResource SettingsDescription}"
                                                                       Margin="0,4,12,0"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="ProofreadingParallelismBox" AutomationProperties.Name="同時送信する段落数"
                                                                     VerticalAlignment="Center"
                                                                     Style="{StaticResource AppTextBox}"
                                                                     TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="段落"
                                                                       Style="{StaticResource FieldLabel}"
                                                                       Margin="0" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsLastRow}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="自動校正のタイムアウト（秒）" Style="{StaticResource FieldLabel}" />
                                                            <TextBox x:Name="AutoTimeoutBox" AutomationProperties.Name="自動校正のタイムアウト（秒）"
                                                                     Grid.Column="1"
                                                                     Style="{StaticResource AppTextBox}" />
                                                        </Grid>
                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="手動校正のタイムアウト（秒）" Style="{StaticResource FieldLabel}" />
                                                            <TextBox x:Name="ManualTimeoutBox" AutomationProperties.Name="手動校正のタイムアウト（秒）"
                                                                     Grid.Column="1"
                                                                     Style="{StaticResource AppTextBox}" />
                                                        </Grid>
                                                        <TextBlock x:Name="TimeoutHintText"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource SettingsDescription}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel></Border>
                                        <TextBlock Text="初回は消費を抑えやすいモデルを選びます。料金情報のない契約サービスでは軽量モデルを優先します。" Style="{StaticResource SettingsDescription}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ===== 学習（文体の適応） ===== -->
                    <TabItem Header="学習" Tag="&#xE82D;" ToolTip="いつもの文体や、校正で大切にしたいルールを設定します。">
                        <ScrollViewer TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="校正のルール" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="カスタム指示" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBlock Text="毎回の校正に使います。スタイルガイドより優先されます。"
                                                           Style="{StaticResource SettingsDescription}" />
                                                <TextBox x:Name="CustomInstructionBox" AutomationProperties.Name="カスタム指示"
                                                         Style="{StaticResource AppTextBox}"
                                                         Height="60"
                                                         Margin="0,10,0,0"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="スタイルガイドの生成を提案する"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="OFFでも「学習」セクションの手編集は引き続き可能です。生成は課金APIを呼ぶため、この設定に関わらず毎回確認します。" />
                                                <CheckBox x:Name="StyleGuideAutoGenerateCheck" AutomationProperties.Name="スタイルガイドの生成を提案する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}"
                                                          ToolTip="OFFでも「学習」セクションの手編集は引き続き可能です。生成は課金APIを呼ぶため、この設定に関わらず毎回確認します。" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="生成を提案する件数"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="前回の確認時点から、これだけ新しいリアクションが積まれたら生成を提案します。" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBox x:Name="StyleGuideThresholdBox" AutomationProperties.Name="生成を提案する件数"
                                                             Width="130"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right" />
                                                    <TextBlock Text="件ごと" Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="スタイルガイド" Style="{StaticResource SectionHeader}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <Border Style="{StaticResource SettingsLastRow}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="スタイルガイドの世代" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="StyleGuideHistoryCombo" AutomationProperties.Name="スタイルガイドの世代"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppComboBox}"
                                                          SelectionChanged="StyleGuideHistoryCombo_SelectionChanged" />
                                            </Grid>
                                            <TextBlock x:Name="StyleGuideStatusText"
                                                       Margin="0,10,0,0"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource SettingsDescription}" />
                                            <TextBox x:Name="StyleGuideContentBox" AutomationProperties.Name="スタイルガイドの内容"
                                                     Style="{StaticResource AppTextBox}"
                                                     Height="100"
                                                     Margin="0,10,0,0"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     ToolTip="生成された（または編集した）ルール文です。自由に書き換えられます。" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button x:Name="StyleGuideSaveButton"
                                                        Style="{StaticResource AppButton}"
                                                        Content="保存"
                                                        Click="StyleGuideSaveButton_Click" />
                                                <Button x:Name="StyleGuideActivateButton"
                                                        Style="{StaticResource AppButton}"
                                                        Content="この世代を使う"
                                                        Margin="8,0,0,0"
                                                        Click="StyleGuideActivateButton_Click" />
                                                <Button x:Name="StyleGuideDeactivateButton"
                                                        Style="{StaticResource AppButton}"
                                                        Content="無効化"
                                                        Margin="8,0,0,0"
                                                        Click="StyleGuideDeactivateButton_Click" />
                                                <Button x:Name="StyleGuideDeleteButton"
                                                        Style="{StaticResource AppButton}"
                                                        Content="この世代を削除"
                                                        Margin="8,0,0,0"
                                                        Click="StyleGuideDeleteButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <!-- ===== 学習効果 ===== -->
                                <TextBlock Text="学習効果" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="リアクションの件数ごとに、拒否率の変化を表示します。"
                                           ToolTip="リアクションを蓄積順にまとめて、拒否率の推移を表示します（暦月ではなく件数で区切ります。学習が効いていれば右に行くほど下がります）。"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,6" />
                                <StackPanel x:Name="RejectionTrendPanel" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ===== API・料金（モデル単価・APIキー） ===== -->
                    <TabItem Header="APIキー" Tag="&#xE72E;" ToolTip="APIの提供元ごとに、認証キーを設定します。" x:Name="ApiTab">
                        <ScrollViewer TextElement.FontWeight="Normal"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="接続するAPI" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="同じ提供元のモデルには、共通のキーを使います。"
                                           Style="{StaticResource SettingsDescription}"
                                           Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="API の提供元" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CredentialProviderCombo" AutomationProperties.Name="API の提供元"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppComboBox}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Provider"
                                                          SelectionChanged="CredentialProviderCombo_SelectionChanged" />
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="CredentialPanel">
                                            <Border Style="{StaticResource SettingsRow}">
                                                <StackPanel>
                                                    <TextBlock x:Name="CredentialUsageText"
                                                               Margin="0,0,0,8"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource SettingsDescription}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="300" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="CredentialSourceLabel"
                                                                   Text="APIキーの取得元"
                                                                   Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="CredentialSourceCombo" AutomationProperties.Name="APIキーの取得元"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppComboBox}"
                                                                  SelectionChanged="CredentialSourceCombo_SelectionChanged" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="300" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="APIキーを入力" Style="{StaticResource FieldLabel}" />
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="APIキーを入力"
                                                                         Style="{StaticResource AppPasswordBox}"
                                                                         PasswordChar="●"
                                                                         PasswordChanged="ApiKeyBox_PasswordChanged"
                                                                         ToolTip="既存のキーは表示しません。未入力のままなら変更しません。" />
                                                            <Button x:Name="DeleteStoredKeyButton"
                                                                    Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Style="{StaticResource AppButton}"
                                                                    Content="キーを削除"
                                                                    Click="DeleteStoredKeyButton_Click" />
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock x:Name="CredentialStatusText"
                                                               Margin="0,8,0,0"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource SettingsDescription}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="キーを空欄にしておくと、保存済みのキーをそのまま使います。変更は「保存して閉じる」で反映します。"
                                           Style="{StaticResource SettingsDescription}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="OpenAI API互換" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                                <TextBlock Text="接続先を複数登録できます。各接続先のモデルIDと入出力単価を設定してください。プリセットはありません。"
                                           TextWrapping="Wrap" Style="{StaticResource SettingsDescription}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Margin="12">
                                        <ComboBox x:Name="CompatibleProfileCombo" Style="{StaticResource AppComboBox}"
                                                  AutomationProperties.Name="OpenAI API互換の接続設定"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                  SelectionChanged="CompatibleProfileCombo_SelectionChanged" />
                                        <TextBlock x:Name="CompatibleProfileSummary" TextWrapping="Wrap"
                                                   Margin="0,8,0,8" Style="{StaticResource SettingsDescription}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="追加" Style="{StaticResource AppButton}" Click="AddCompatibleProfile_Click" Margin="0,0,8,0" />
                                            <Button x:Name="EditCompatibleProfileButton" Content="編集" Style="{StaticResource AppButton}"
                                                    Click="EditCompatibleProfile_Click" Margin="0,0,8,0" />
                                            <Button x:Name="DeleteCompatibleProfileButton" Content="削除" Style="{StaticResource AppButton}"
                                                    Click="DeleteCompatibleProfile_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="互換接続の料金は入力した単価から概算します。キャッシュ料金は反映しません。読み込み割引が適用されると高めになり、書き込み割増などがあると実額が上回る場合があります。"
                                           TextWrapping="Wrap" Style="{StaticResource SettingsDescription}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="料金" Tag="&#xE8C7;" ToolTip="APIの利用上限と、概算料金の表示を管理します。" x:Name="PricingTab">
                        <ScrollViewer TextElement.FontWeight="Normal"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="利用上限・確認" Style="{StaticResource SectionHeader}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="課金API実行前の確認を表示する"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="オフにすると、校正・別案生成の前に確認せず実行します。" />
                                                <CheckBox x:Name="ConfirmPaidApiCallsCheck" AutomationProperties.Name="課金API実行前の確認を表示する"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppToggleCheckBox}"
                                                          ToolTip="オフにすると、校正・別案生成の前に確認せず実行します。" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="月間上限額（USD）" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="0 = 上限なし"
                                                               Style="{StaticResource SettingsDescription}"
                                                               Margin="0,4,12,0" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MonthlyLimitBox" AutomationProperties.Name="月間上限額（USD）"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="USD"
                                                               Style="{StaticResource FieldLabel}"
                                                               Margin="0" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="上限接近の警告"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="当月の累計がこの割合を超えたら、ステータスバーの進捗バーを警告色にします。" />
                                                <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MonthlyLimitWarningBox" AutomationProperties.Name="上限接近の警告"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="%"
                                                               Style="{StaticResource FieldLabel}"
                                                               Margin="0" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel ToolTip="{StaticResource ApiLogRetentionHelp}">
                                                    <TextBlock Text="明細の保持期間" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="0で無期限"
                                                               Style="{StaticResource SettingsDescription}"
                                                               Margin="0,4,12,0" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="210" HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ApiLogRetentionBox" AutomationProperties.Name="明細の保持期間（か月）"
                                                             Style="{StaticResource AppTextBox}"
                                                             TextAlignment="Right"
                                                             ToolTip="{StaticResource ApiLogRetentionHelp}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="か月"
                                                               Style="{StaticResource FieldLabel}"
                                                               Margin="0"
                                                               ToolTip="{StaticResource ApiLogRetentionHelp}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="料金の計算に使う単価" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="概算用の単価です。キャッシュ料金は計算しません。読み込み割引が適用されると表示額は高めになり、書き込み割増などがあると実額が上回る場合があります。OpenAI API互換の単価は「APIキー」で編集します。"
                                           Style="{StaticResource SettingsDescription}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="単価を確認するモデル" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="PricingModelCombo" AutomationProperties.Name="単価を確認するモデル"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppComboBox}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Id"
                                                          SelectionChanged="PricingModelCombo_SelectionChanged"
                                                          MaxDropDownHeight="360">
                                                    <ComboBox.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Margin="8,10,8,4"
                                                                               Foreground="{DynamicResource TextBrush}" />
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ComboBox.GroupStyle>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="PricingCurrentSummaryText"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12" />
                                <Expander x:Name="PricingHistoryExpander" Header="単価の履歴・変更" Style="{StaticResource SettingsExpander}">
                                    <StackPanel>
                                        <Border Height="240"
                                                BorderBrush="{DynamicResource SettingsSeparatorBrush}"
                                                BorderThickness="1"
                                                Padding="6">
                                            <controls:PricingHistoryChart x:Name="PricingHistoryChart"
                                                                          AutomationProperties.Name="入力単価と出力単価の履歴グラフ" />
                                        </Border>
                                        <Border Style="{StaticResource SettingsLastRow}">
                                            <StackPanel>
                                                <TextBlock Text="料金履歴" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                                <ListView x:Name="PricingHistoryList"
                                                          Height="160"
                                                          SelectionMode="Single"
                                                          Background="{DynamicResource ControlBackgroundBrush}"
                                                          Foreground="{DynamicResource TextBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          BorderThickness="1"
                                                          ItemContainerStyle="{StaticResource AppListViewItem}"
                                                          SelectionChanged="PricingHistoryList_SelectionChanged"
                                                          AutomationProperties.Name="選択モデルの料金履歴">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="適用日"
                                                                            Width="86"
                                                                            DisplayMemberBinding="{Binding EffectiveFromText}" />
                                                            <GridViewColumn Header="出典"
                                                                            Width="104"
                                                                            DisplayMemberBinding="{Binding SourceText}" />
                                                            <GridViewColumn Header="入力"
                                                                            Width="76"
                                                                            DisplayMemberBinding="{Binding InputText}" />
                                                            <GridViewColumn Header="入力の増減"
                                                                            Width="108"
                                                                            DisplayMemberBinding="{Binding InputDeltaText}" />
                                                            <GridViewColumn Header="出力"
                                                                            Width="76"
                                                                            DisplayMemberBinding="{Binding OutputText}" />
                                                            <GridViewColumn Header="出力の増減"
                                                                            Width="108"
                                                                            DisplayMemberBinding="{Binding OutputDeltaText}" />
                                                            <GridViewColumn Header="状態"
                                                                            Width="78"
                                                                            DisplayMemberBinding="{Binding StatusText}" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button x:Name="PricingAddButton"
                                                            Style="{StaticResource AppButton}"
                                                            Content="価格を追加"
                                                            Click="PricingAddButton_Click" />
                                                    <Button x:Name="PricingRestoreButton"
                                                            Style="{StaticResource AppButton}"
                                                            Content="公式価格へ戻す"
                                                            Margin="8,0,0,0"
                                                            Click="PricingRestoreButton_Click" />
                                                    <Button x:Name="PricingEditButton"
                                                            Style="{StaticResource AppButton}"
                                                            Content="編集"
                                                            Margin="8,0,0,0"
                                                            IsEnabled="False"
                                                            Click="PricingEditButton_Click" />
                                                    <Button x:Name="PricingDeleteButton"
                                                            Style="{StaticResource AppButton}"
                                                            Content="削除"
                                                            Margin="8,0,0,0"
                                                            IsEnabled="False"
                                                            Click="PricingDeleteButton_Click" />
                                                </StackPanel>
                                                <TextBlock x:Name="PricingSelectionHelpText"
                                                           Margin="0,6,0,0"
                                                           Text="公式価格は読み取り専用です。ユーザー設定の行を選ぶと編集・削除できます。"
                                                           Style="{StaticResource SettingsDescription}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="PricingErrorText"
                                                   Margin="16,2,16,8"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="ステータスバーの料金表示" Style="{StaticResource SettingsExpander}">
                                    <StackPanel>
                                        <!-- ===== ステータスバー（課金表示） ===== -->
                                        <TextBlock Text="ステータスバー（課金表示）" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="メイン画面の下段に表示する料金情報を選びます。"
                                                   ToolTip="下段に表示する課金情報です。項目の並び順は固定で、料金表示形式は有効にした全項目へ共通適用されます。月間上限の進捗バーと上限到達警告は、この設定に関係なく従来どおり表示されます。課金履歴の内容はこの設定で変わりません。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsDescription}"
                                                   Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="直近の入出力トークンと料金を表示" Style="{StaticResource FieldLabel}" />
                                                        <CheckBox x:Name="StatusBarLatestCheck" AutomationProperties.Name="直近の入出力トークンと料金を表示"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppToggleCheckBox}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="起動後の料金を表示" Style="{StaticResource FieldLabel}" />
                                                        <CheckBox x:Name="StatusBarSessionCheck" AutomationProperties.Name="起動後の料金を表示"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppToggleCheckBox}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="当日の料金を表示" Style="{StaticResource FieldLabel}" />
                                                        <CheckBox x:Name="StatusBarTodayCheck" AutomationProperties.Name="当日の料金を表示"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppToggleCheckBox}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="当月の料金を表示" Style="{StaticResource FieldLabel}" />
                                                        <CheckBox x:Name="StatusBarMonthCheck" AutomationProperties.Name="当月の料金を表示"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppToggleCheckBox}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="為替情報を表示" Style="{StaticResource FieldLabel}" />
                                                        <CheckBox x:Name="StatusBarFxCheck" AutomationProperties.Name="為替情報を表示"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppToggleCheckBox}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SettingsLastRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="料金表示形式" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="StatusBarCurrencyCombo" AutomationProperties.Name="料金表示形式"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource AppComboBox}"
                                                                  HorizontalAlignment="Right"
                                                                  Width="200" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SettingsCardBackgroundBrush}">
                    <DockPanel Margin="20,12">
                        <Button x:Name="OpenFolderButton"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AppButton}"
                                Content="データフォルダを開く"
                                MinWidth="140"
                                Click="OpenFolderButton_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton"
                                    Style="{StaticResource AppButton}"
                                    Content="キャンセル"
                                    MinWidth="100"
                                    Height="38"
                                    IsCancel="True"
                                    Click="CancelButton_Click" />
                            <Button x:Name="OkButton"
                                    Style="{StaticResource SettingsSaveButton}"
                                    Content="保存して閉じる"
                                    MinWidth="100"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    IsDefault="True"
                                    Click="OkButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
