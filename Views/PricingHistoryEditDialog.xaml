<Window x:Class="JpScratch.Views.PricingHistoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="モデル単価の履歴"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DescriptionText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="適用開始日" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="EffectiveDatePicker"
                            Grid.Column="1"
                            SelectedDateFormat="Short"
                            ToolTip="この日を含めて新しい価格を適用します。" />
            </Grid>

            <Grid x:Name="InputPriceRow" Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="入力単価" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="InputPriceBox"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         TextAlignment="Right" />
                <TextBlock x:Name="InputUnitText"
                           Grid.Column="2"
                           Margin="10,0,0,0"
                           Style="{StaticResource FieldLabel}" />
            </Grid>

            <Grid x:Name="OutputPriceRow" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="出力単価" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OutputPriceBox"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         TextAlignment="Right" />
                <TextBlock x:Name="OutputUnitText"
                           Grid.Column="2"
                           Margin="10,0,0,0"
                           Style="{StaticResource FieldLabel}" />
            </Grid>

            <TextBlock x:Name="ValidationText"
                       Grid.Row="4"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="キャンセル"
                        Style="{StaticResource AppButton}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="決定"
                        Style="{StaticResource AppButton}"
                        IsDefault="True"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
