<Window x:Class="JpScratch.Views.OpenAiCompatibleProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenAI API互換の接続設定"
        Width="590" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="OpenAI API互換の接続設定" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                        Style="{StaticResource ChromeButton}" FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;" ToolTip="閉じる"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="OpenAI API互換の接続設定" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Chat Completions の完全なURL、モデルID、100万トークン当たりのUSD単価を入力してください。"
                       TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="表示名" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}" Margin="0,3,0,11" />
            <TextBlock Text="Chat Completions のURL" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EndpointBox" Style="{StaticResource AppTextBox}" Margin="0,3,0,4"
                     ToolTip="例: https://example.com/v1/chat/completions" />
            <TextBlock Text="末尾に /chat/completions を含む完全なURL。HTTP通信では本文とキーが暗号化されません。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,11" />
            <TextBlock Text="APIのモデルID" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ModelBox" Style="{StaticResource AppTextBox}" Margin="0,3,0,11" />
            <Grid Margin="0,0,0,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="入力 USD / 100万トークン" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="InputPriceBox" Style="{StaticResource AppTextBox}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="出力 USD / 100万トークン" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OutputPriceBox" Style="{StaticResource AppTextBox}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Text="キャッシュ料金は計算しません。読み込み割引が適用されると表示額は高めになり、書き込み割増があると低めになる場合があります。追加料金や単価変更も含みません。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,11" />
            <TextBlock Text="APIキー（不要なら空欄）" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource AppPasswordBox}" Margin="0,3,0,4" />
            <TextBlock Text="編集時に空欄なら保存済みのキーを維持します。キーは接続設定ごとに暗号化して保存します。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
            <CheckBox x:Name="DeleteKeyCheck" Content="保存済みのキーを削除する" Margin="0,8,0,0" />
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="キャンセル" Style="{StaticResource AppButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="決定" Style="{StaticResource AppButton}" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
