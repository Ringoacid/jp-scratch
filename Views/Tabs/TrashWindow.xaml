<Window x:Class="JpScratch.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ゴミ箱"
        Width="680" Height="500"
        MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}">
                <TextBlock Text="ゴミ箱"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource ChromeButton}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        ToolTip="閉じる"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="TitleBarCloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 操作 -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <Button x:Name="RestoreButton"
                            DockPanel.Dock="Left"
                            Style="{StaticResource AppButton}"
                            Content="復元"
                            Click="RestoreButton_Click" />
                    <Button x:Name="EmptyTrashButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource DangerButton}"
                            Content="ゴミ箱を空にする"
                            Click="EmptyTrashButton_Click" />
                    <Button x:Name="DeleteButton"
                            DockPanel.Dock="Left"
                            Style="{StaticResource DangerButton}"
                            Content="完全に削除"
                            Margin="8,0"
                            Click="DeleteButton_Click" />
                </DockPanel>

                <!-- 一覧 -->
                <ListView x:Name="ResultsList"
                          Grid.Row="1"
                          Margin="0,10,0,0"
                          Background="{DynamicResource ControlBackgroundBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ItemContainerStyle="{StaticResource AppListViewItem}"
                          SelectionChanged="ResultsList_SelectionChanged"
                          MouseDoubleClick="ResultsList_MouseDoubleClick"
                          KeyDown="ResultsList_KeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="タイトル" Width="300"
                                            DisplayMemberBinding="{Binding Tab.Title}" />
                            <GridViewColumn Header="閉じた日時" Width="140"
                                            DisplayMemberBinding="{Binding DeletedAtText}" />
                            <GridViewColumn Header="行数" Width="70"
                                            DisplayMemberBinding="{Binding LineCountDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- プレビュー -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="本文プレビュー"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12" />
                    <TextBox x:Name="PreviewBox"
                             Grid.Row="1"
                             Margin="0,4,0,0"
                             Style="{StaticResource AppTextBox}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             VerticalContentAlignment="Top"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock x:Name="SummaryText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
