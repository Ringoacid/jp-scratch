<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ライトテーマ（要件 3.2.2）。長文を書く道具なので、白すぎない紙色を基調にする。 -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />

    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="CurrentLineBackgroundBrush" Color="#F0F4FB" />
    <SolidColorBrush x:Key="CurrentLineBorderBrush" Color="#DCE6F5" />
    <SolidColorBrush x:Key="LineNumberForegroundBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#B3D4FC" />
    <SolidColorBrush x:Key="WhitespaceBrush" Color="#C8C8C8" />

    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3A7AE0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF0000" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF3838" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#A80000" />

    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#DEDEDE" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#EDEDED" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#CFCFCF" />

    <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="SettingsSeparatorBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrongTextBrush" Color="#000000" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#E8E8E8" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C4C4C4" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6" />

    <SolidColorBrush x:Key="SearchMatchBrush" Color="#FFE9A8" />
    <SolidColorBrush x:Key="SearchCurrentMatchBrush" Color="#FFB454" />
    <!-- 校正提案のインライン差分（要件 3.3.5 / docs/proofreading-ux-fixes-plan.md §4・§5）。色だけに頼らず、
         修正前は取り消し線という「形」でも区別できるようにしてある。選択中は背景＋枠線で
         変更単位全体（修正前＋修正後）を囲む。 -->
    <SolidColorBrush x:Key="ProofreadingOriginalBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="ProofreadingStrikeBrush" Color="#CC3B3B" />
    <SolidColorBrush x:Key="ProofreadingSuggestionBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="ProofreadingSelectionBackgroundBrush" Color="#38D97706" />
    <SolidColorBrush x:Key="ProofreadingSelectionBorderBrush" Color="#D97706" />

    <!-- 課金ガード（要件 3.6.3）: ステータスバーの月間上限進捗バー -->
    <SolidColorBrush x:Key="UsageProgressTrackBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="UsageProgressNormalBrush" Color="#3A7AE0" />
    <SolidColorBrush x:Key="UsageProgressWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="UsageProgressReachedBrush" Color="#C63C3C" />

</ResourceDictionary>
