<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ダークテーマ（要件 3.2.2）。真っ黒だと日本語の細い横線が消えるので、やや持ち上げた黒にする。 -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />

    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="CurrentLineBackgroundBrush" Color="#282C34" />
    <SolidColorBrush x:Key="CurrentLineBorderBrush" Color="#33383F" />
    <SolidColorBrush x:Key="LineNumberForegroundBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2F5C8F" />
    <SolidColorBrush x:Key="WhitespaceBrush" Color="#4A4A4A" />

    <SolidColorBrush x:Key="TextBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4285F4" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E06C6C" />

    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#323232" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#3A3A3A" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#484848" />

    <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="SettingsSeparatorBrush" Color="#383838" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrongTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#2A2A2A" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#5F5F5F" />

    <SolidColorBrush x:Key="SearchMatchBrush" Color="#5B4A1E" />
    <SolidColorBrush x:Key="SearchCurrentMatchBrush" Color="#9A6A15" />
    <SolidColorBrush x:Key="ProofreadingUnderlineBrush" Color="#F0A43A" />
    <SolidColorBrush x:Key="ProofreadingSelectionBrush" Color="#335B3A12" />

    <!-- 課金ガード（要件 3.6.3）: ステータスバーの月間上限進捗バー -->
    <SolidColorBrush x:Key="UsageProgressTrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="UsageProgressNormalBrush" Color="#4285F4" />
    <SolidColorBrush x:Key="UsageProgressWarningBrush" Color="#F0A43A" />
    <SolidColorBrush x:Key="UsageProgressReachedBrush" Color="#E06C6C" />

</ResourceDictionary>
